{
  "name": "@the-clubs/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./realtime/useLaneSession": {
      "types": "./realtime/useLaneSession.ts",
      "import": "./dist/realtime/useLaneSession.js",
      "require": "./dist/realtime/useLaneSession.js",
      "default": "./dist/realtime/useLaneSession.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}