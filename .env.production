# Production environment for EC2 deployment
# Place this file at /home/ec2-user/.env on the EC2 instance.
# Do NOT commit secrets to git.

# Database
DB_NAME=club_operations
DB_USER=clubops
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# API
NODE_ENV=production
PORT=3000

# CORS — set to your S3 bucket URLs (comma-separated)
# Example: http://the-clubs-customer-kiosk.s3-website-us-east-1.amazonaws.com,http://the-clubs-employee-register.s3-website-us-east-1.amazonaws.com
CORS_ORIGINS=*
