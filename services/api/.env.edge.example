PORT=3000
HOST=0.0.0.0

# Edge stack Postgres (docker-compose.edge.yml)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=club_operations
DB_USER=clubops
DB_PASSWORD=club-ops-edge
DB_SSL=false
DB_POOL_MAX=20

DB_LOG_QUERIES=false

# Demo / dev defaults
DEMO_MODE=true
SEED_ON_STARTUP=false

# Local-only. Do not commit real secrets.
KIOSK_TOKEN=development

SQUARE_ACCESS_TOKEN=development
SQUARE_LOCATION_ID=development
SQUARE_ENVIRONMENT=sandbox

DB_SSL_CA_PATH=
