# =============================================================================
# the-clubs API Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit actual secrets to version control.

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Skip database initialization (useful for testing without DB)
# SKIP_DB=true

# =============================================================================
# Database Configuration
# =============================================================================
# Connection string (preferred) OR individual components
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Individual components (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=club_operations
DB_USER=clubops
DB_PASSWORD=changeme
DB_SSL=false
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_WAIT_TIMEOUT_SECONDS=300
DB_WAIT_RETRY_DELAY_MS=1000

# =============================================================================
# Authentication
# =============================================================================
# Kiosk token for LAN-based authentication
# Must be set in production - used by kiosk devices
KIOSK_TOKEN=changeme

# WebAuthn Configuration
# RP ID for WebAuthn (Relying Party ID)
# For development: localhost
# For production: your actual domain (e.g., clubops.example.com)
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_ORIGIN=http://localhost:3000
# WEBAUTHN_RP_NAME=Club Operations

# =============================================================================
# CORS (Production)
# =============================================================================
# Comma-separated list of allowed origins
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# =============================================================================
# External Services
# =============================================================================
# Square API (Payment Processing)
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_ENVIRONMENT=sandbox

# =============================================================================
# Edge Stack / Multi-Instance Deployment
# =============================================================================
# Enable edge stack mode for multi-instance deployments
# EDGE_STACK=true

# Cloud API base URL for edge stack mode
# CLOUD_API_BASE_URL=https://api.example.com

# AppSync Events (Realtime)
# Leave blank to disable AppSync Events publishing
# APPSYNC_EVENTS_HTTP_ENDPOINT=
# Channel namespace (defaults to "club-ops")
# APPSYNC_EVENTS_CHANNEL_NAMESPACE=club-ops

# =============================================================================
# OpenTelemetry (Observability)
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=the-clubs-api
# OTEL_SERVICE_VERSION=1.0.0

# =============================================================================
# Demo Mode (Development Only)
# =============================================================================
# DEMO_MODE=false
# SEED_ON_STARTUP=false
# SKIP_DEMO_SEED=true
# FORCE_RESEED=true
# DEMO_RESET_ON_STARTUP=false

# =============================================================================
# Business Logic Configuration
# =============================================================================
# Comma-separated ranges for grandfathered membership numbers
# GYM_LOCKER_ELIGIBLE_RANGES=1000-1999,5000-5999

# =============================================================================
# Debug Options (Development Only)
# =============================================================================
# Set to 'true' to log all database queries
# DB_LOG_QUERIES=false

# =============================================================================
# React Apps (Frontend)
# =============================================================================
# REACT_APP_API_URL=http://localhost:3000
